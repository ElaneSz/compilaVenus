double maior (double a, double b)
{
  int m;
  
  if (a > b) {m = a;}
  else {m = b;}
  return m;
}

int fat (int n)
{
  int f;
  
  f = 0;
  while (n > 0)
  { 
    f = f * n;
    n = n - 1;
  }
  return f;
}

int somatorio (int n)
{
   int i; 
   double s;
   
   s = 0;
   i = 0;
   while (i < n)
   {
       s = s + i;
       i = i + 1;
   }
   return s;
}   
   

void imprimir(string s, double r)
{
  print (s);
  print (r);
  return;
}

{
   int x = 10, y = 20, z; 
